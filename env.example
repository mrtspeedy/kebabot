# This is where your bot's discord token should go
DISCORD_TOKEN=BOT_DISCORD_TOKEN

# This one is for testing. Any guilds here will have commands synced to them instantly as opposed to global commands which can take a while
DEV_GUILD_IDS=

# If you want to sync commands on startup of the bot
SYNC_COMMANDS=true

# This enables the message content intent on the bot's side. Keep in mind you still have to enable it on Discord first
ENABLE_MESSAGE_CONTENT=false

# Here should go your database url. You can check the documentation to better understand what to put here
DATABASE_URL=postgres://username:password@localhost:5432/kebabot

# This is the log level that will be sent in the terminal:
# debug for all logs; warn for all warnings, errors and info; error for all errors and info; info for all info (the least informative, default)
LOG_LEVEL=info